<h1 class="admin-page-title">{{formTitle}}</h1>
<p class="admin-page-desc">{{formDescription}}</p>
{{#if errorMessage}}
<p class="admin-alert-error">{{errorMessage}}</p>
{{/if}}
<p id="faq-client-error" class="admin-alert-error" style="display:none;" role="alert" aria-live="polite"></p>
<form method="post" action="{{formAction}}" class="admin-form" id="faq-form" novalidate>
  <label class="admin-label">
    Question *
    <input class="admin-input" name="question" maxlength="255" required value="{{questionValue}}" data-field="question" />
  </label>
  <label class="admin-label">
    Answer *
    <textarea class="admin-textarea" name="answer" rows="6" required data-field="answer">{{answerValue}}</textarea>
  </label>
  <div style="display:flex; gap:10px; align-items:center;">
    <button class="btn btn-primary" type="submit">Save</button>
    <a class="btn" href="/faqs" style="text-decoration:none;">Cancel</a>
  </div>
</form>
<script src="/js/faq-form-validation.js"></script>